{
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "vendor-dir": "vendor",
    "preferred-install": {
      "*": "dist"
    },
    "platform-check": false,
    "autoloader-suffix": "PressPermit"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/publishpress/library-publishpress-welcome"
    }
  ],
  "require": {
    "php": ">=7.2.5",
    "publishpress/pimple-pimple": "^3.5.0.9",
    "publishpress/psr-container": "^2.0.1.9",
    "publishpress/instance-protection": "^2.0",
    "publishpress/publishpress-welcome": "dev-codex/welcome-library",
    "publishpress/wordpress-reviews":  "^1.1",
    "publishpress/wordpress-version-notices": "^2.1"
  }
}
