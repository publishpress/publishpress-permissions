{
  "name": "publishpress/publishpress-permissions",
  "type": "wordpress-plugin",
  "description": "WordPress plugin: control permissions for publishing workflow and presentation",
  "homepage": "https://publishpress.com/",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "PublishPress",
      "email": "help@publishpress.com",
      "homepage": "https://publishpress.com",
      "role": "Developer"
    },
    {
      "name": "Kevin Behrens",
      "email": "kevin@agapetry.net",
      "homepage": "https://agapetry.net",
      "role": "Lead Developer"
    }
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "publishpress/dev-workspace": true
    },
    "preferred-install": {
      "*": "dist"
    },
    "process-timeout": 7200
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=7.2.5",
    "ext-json": "*"
  },
  "require-dev": {
    "publishpress/dev-workspace": "^2.0.1"
  },
  "scripts": {
    "info:version": "@info:versions",
    "build:dir": "@pack:dir",
    "build:clean": "@pack:clean",
    "gen:mo": "wp i18n make-mo ./languages ./languages --allow-root",
    "gen:pot": "wp i18n make-pot . languages/press-permit-core.pot --domain=press-permit-core --exclude=dev-workspace-cache,vendor,.wordpress-org,.github,dist,tests,lib,tmp,doc,*.js,*.js.map --allow-root",
    "check:lint": "@lint:php",
    "check:phpcs": "@lint:phpcs",
    "check:php56": "@check:php-5.6",
    "check:php72": "@check:php-7.2",
    "check:php74": "@check:php-7.4",
    "check:php80": "@check:php-8.0",
    "check:php81": "@check:php-8.1",
    "check:php82": "@check:php-8.2",
    "pre-autoload-dump": "@composer dumpautoload --working-dir=./lib",
    "pre-update-cmd": "@composer update --working-dir=./lib",
    "pre-install-cmd": "@composer install --working-dir=./lib",
    "term": "bash ./vendor/publishpress/dev-workspace/scripts/run.sh"
  },
  "extra": {
    "plugin-slug": "press-permit-core",
    "plugin-name": "publishpress-permissions",
    "plugin-folder": "press-permit-core",
    "version-constant": "PRESSPERMIT_VERSION",
    "plugin-lang-domain": "press-permit-core",
    "plugin-github-repo": "publishpress/publishpress-permissions",
    "plugin-composer-package": "publishpress/publishpress-permissions"
  }
}
